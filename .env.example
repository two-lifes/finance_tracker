# Token from @BotFather
BOT_TOKEN=
# Your numeric Telegram id (e.g. from @userinfobot); the bot ignores everyone else
ALLOWED_USER_ID=
# Optional proxy for Telegram API: socks5://user:pass@host:port or http://user:pass@host:port
PROXY_URL=
# SQLite file location
DB_PATH=data/finance.db

# Subscription bot API (read-only). Empty values turn subscriptions off.
# On the server both bots share the docker network "bots_internal", see deploy/docker-compose.yml
SUBS_API_URL=http://subs-api:8080
SUBS_API_TOKEN=
